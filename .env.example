# LLM: ollama | groq
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434
# token di contesto: 4096 basta ai prompt (il più lungo ~1000 con la risposta) e sta in VRAM;
# oltre il limite Ollama taglia il testo senza avvisare
LLM_NUM_CTX=4096

LLM_TEMPERATURE=0.0
LLM_NUM_PREDICT=2048
# LLM_REPEAT_PENALTY=1.1   # lascia commentato per usare il default di Ollama

# Prestazioni. Controlla con "ollama ps": la colonna PROCESSOR deve dire "100% GPU".
# Se mostra una parte di CPU, LLM_NUM_GPU=99 mette tutti i layer sulla GPU (circa il doppio
# più veloce su una GTX 1060 6GB). Commentato = decide Ollama, con prudenza.
# LLM_NUM_GPU=99
# quanto i modelli restano caricati dopo l'ultima chiamata (default 30m; Ollama da solo: 5m)
LLM_KEEP_ALIVE=30m
# LLM_PROVIDER può essere: ollama | langchain_ollama | groq

# Only if LLM_PROVIDER=groq (free tier)
GROQ_API_KEY=

# Database
DATABASE_URL=postgresql://planner:planner@localhost:5433/planner

# Calendario (.ics): fuso orario degli eventi
TIMEZONE=Europe/Rome