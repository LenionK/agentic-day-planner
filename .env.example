# LLM: ollama | groq
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434
LLM_NUM_CTX=8192

LLM_TEMPERATURE=0.0
LLM_NUM_PREDICT=2048
# LLM_REPEAT_PENALTY=1.1   # lascia commentato per usare il default di Ollama
# LLM_PROVIDER può essere: ollama | langchain_ollama | groq

# Only if LLM_PROVIDER=groq (free tier)
GROQ_API_KEY=

# Database
DATABASE_URL=postgresql://planner:planner@localhost:5433/planner